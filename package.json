{
  "name": "lingq-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for LingQ API integration",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "bun dist/index.js",
    "dev": "bun run build && bun dist/index.js",
    "dev:ts": "bun src/index.ts",
    "watch": "tsc --watch",
    "test:integration": "bun tests/integration.test.ts",
    "test:railway": "MCP_SERVER_URL=https://lingq-mcp-production.up.railway.app/mcp bun tests/integration.test.ts"
  },
  "keywords": [
    "mcp",
    "lingq",
    "language-learning"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.5",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
