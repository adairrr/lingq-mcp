{
  "name": "lingq-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for LingQ API integration",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "pnpm run build && node dist/index.js",
    "watch": "tsc --watch",
    "test:integration": "npx ts-node tests/integration.test.ts",
    "test:railway": "MCP_SERVER_URL=https://lingq-mcp-production.up.railway.app/mcp npx ts-node tests/integration.test.ts"
  },
  "keywords": ["mcp", "lingq", "language-learning"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "axios": "^1.13.2",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
