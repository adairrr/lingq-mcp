# LingQ API Key (required for both modes)
# Get your API key from: https://www.lingq.com/en/accounts/apikey/
LINGQ_API_KEY=your_lingq_api_key_here

# Transport Mode (optional, default: http)
# - stdio: For local Claude Desktop integration (no AUTH_TOKEN required)
# - http: For Railway/n8n deployment (AUTH_TOKEN required)
# TRANSPORT_MODE=http

# Authentication Token for MCP Server (required for HTTP mode only)
# Generate a secure token with: openssl rand -hex 32
# Not required when TRANSPORT_MODE=stdio
AUTH_TOKEN=your_secure_random_token_here

# Server Port (optional, Railway sets this automatically)
# Only used in HTTP mode
# PORT=3000

# Node Environment (optional)
# NODE_ENV=production

# Allowed CORS Origins (optional, comma-separated)
# Only used in HTTP mode
# ALLOWED_ORIGINS=https://n8n.example.com,https://another-domain.com
